# Host Nginx (TLS) for the DEV backend. Copy as root:
#   cp nginx-host-api-dev.conf.example /etc/nginx/sites-available/api-dev.hoamytech.com
#   ln -s /etc/nginx/sites-available/api-dev.hoamytech.com /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d api-dev.hoamytech.com     # adds the 443 server + redirect
# Does not touch the api.hoamytech.com server block. Dev Compose nginx listens on 127.0.0.1:8081.
server {
    listen 80;
    listen [::]:80;
    server_name api-dev.hoamytech.com;

    client_max_body_size 32m;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering off;
    }
}
