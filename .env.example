# Bắt buộc để đăng nhập trang quản trị ở cả local và production.
# Dùng mật khẩu dài, riêng biệt; thay đổi một trong hai giá trị sẽ đăng xuất mọi phiên cũ.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Xác thực installation ẩn danh dùng chung cho iOS, Android và Flutter Web.
# Tạo một secret riêng tối thiểu 32 byte. Deploy backend với REQUIRED=false,
# phát hành app có token, sau đó đổi REQUIRED=true trước khi submit App Store.
INSTALLATION_AUTH_SECRET=
INSTALLATION_AUTH_REQUIRED=false
INSTALLATION_ACCESS_TTL_SECONDS=3600
INSTALLATION_REFRESH_TTL_SECONDS=7776000
INSTALLATION_REGISTRATION_REQUESTS_PER_MINUTE=12

# Bắt buộc để lưu giọng nói của người dùng sau khi backend đã trả phản hồi.
# Audio được upload dưới dạng Cloudinary video/authenticated và chỉ phát qua API admin.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_USER_AUDIO_FOLDER=speaking-ai/user-audio
# Production child-data retention. Cleanup runs on startup and then daily.
# Audio is removed from Cloudinary after 30 days while the transcript remains
# until the 180-day history limit. Detailed benchmark/latency data is removed
# after 30 days. Manual deletion/consent withdrawal deletes all three at once.
USER_AUDIO_RETENTION_DAYS=30
HISTORY_RETENTION_DAYS=180
DIAGNOSTIC_RETENTION_DAYS=30
DATA_RETENTION_CLEANUP_INTERVAL_SECONDS=86400
# Legacy migration fallback only; leave empty when all three values above exist.
CHILD_DATA_RETENTION_DAYS=
LATENCY_P95_ALERT_MS=2500
# TTS chỉ dùng Cloudflare. Audio đã tạo được lưu vào cache dùng chung.
CLOUDFLARE_TTS_MODEL=@cf/deepgram/aura
CLOUDFLARE_TTS_SPEAKER=luna
CLOUDFLARE_TTS_TIMEOUT_MS=20000
# Chỉ tạo trước tối đa 100-300 câu phổ biến; mặc định 200. Các rule còn lại
# sinh audio đúng một lần khi gặp lần đầu rồi lưu lâu dài trên backend.
AUDIO_WARMUP_RULE_LIMIT=200
AUDIO_WARMUP_CONCURRENCY=2

# ASR, dịch text V1 và TTS đều chỉ dùng Cloudflare Workers AI.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_API_TOKEN=
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
CLOUDFLARE_TEXT_TIMEOUT_MS=6000

# Endpoint audio/translate độc lập (không phải pipeline Flutter chính).
CLOUDFLARE_WORKERS_AI_MODEL=@cf/openai/whisper-large-v3-turbo
CLOUDFLARE_AUDIO_MAX_BYTES=10485760
CLOUDFLARE_WORKERS_AI_TIMEOUT_MS=6000
CLOUDFLARE_ASR_TIMEOUT_MS=4000
# 2 ưu tiên tốc độ cho câu ngắn; đặt 5 để quay lại beam mặc định của model.
CLOUDFLARE_ASR_BEAM_SIZE=2
# client: disable Cloudflare VAD only when Flutter confirms client-side VAD.
# cloudflare: keep provider VAD enabled for an A/B comparison or rollback.
CLOUDFLARE_ASR_VAD_MODE=client

# Reviewed child-speech aliases are enabled by default and use an in-memory
# exact full-sentence lookup. Set false only for an emergency pilot rollback.
CHILD_SPEECH_ALIASES_ENABLED=true

# Danh sách origin Flutter Web/PWA, phân cách bằng dấu phẩy. Không thêm dấu / cuối.
# Ví dụ: https://app.innotrik.com,https://staging-app.innotrik.com
PWA_ALLOWED_ORIGINS=

# Lưu trữ production. Giữ "local" trong lúc phát triển một máy.
PERSISTENCE_BACKEND=local
AUDIO_STORAGE_BACKEND=local

# Khi chuyển production: PERSISTENCE_BACKEND=postgres và cấu hình Neon.
# Nếu bỏ trống AUDIO_STORAGE_BACKEND, audio cũng tự dùng PostgreSQL để không
# mất cache sau deploy/restart. Có thể đặt rõ AUDIO_STORAGE_BACKEND=postgres.
DATABASE_URL=

# Khi chuyển audio production: AUDIO_STORAGE_BACKEND=vercel-blob.
# Store này phải là public vì chỉ chứa câu tiếng Anh đã sinh, không chứa giọng trẻ.
GENERATED_AUDIO_BLOB_READ_WRITE_TOKEN=

# Hoặc dùng Cloudflare R2 cho audio cache bất biến. Chỉ bật sau khi đã tạo
# R2 API token và public/custom domain cho bucket.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Production fast path: keep temporary chunk bytes in private R2 objects while
# PostgreSQL stores only session metadata. AUDIO_STORAGE_BACKEND=r2 enables this
# automatically; this explicit setting also works when generated audio uses a
# different backend. Add an R2 lifecycle rule for audio-sessions/ (1 day).
AUDIO_SESSION_CHUNK_STORAGE_BACKEND=r2

# Giới hạn upload giọng nói của trẻ. Metadata session và chunk tự xóa sau TTL;
# bytes của chunk nằm trong R2 khi bật fast path ở trên.
AUDIO_UPLOAD_MAX_CHUNK_BYTES=1048576
AUDIO_UPLOAD_MAX_SESSION_BYTES=16777216
AUDIO_UPLOAD_MAX_CHUNKS=1000
AUDIO_UPLOAD_SESSION_TTL_SECONDS=900
# Bounded per-instance PCM shadow cache; set 0 to force PostgreSQL/R2 assembly.
AUDIO_SESSION_HOT_CACHE_MAX_BYTES=67108864
AUDIO_FINALIZED_RESULT_TTL_SECONDS=86400
AUDIO_FINALIZE_LEASE_SECONDS=60
AUDIO_UPLOAD_CLEANUP_INTERVAL_SECONDS=300

# Khóa HMAC riêng để cấp upload token ngắn hạn, ràng buộc từng audio session.
# Tạo tối thiểu 32 byte ngẫu nhiên. Bật REQUIRE sau khi Web/APK mới đã phát hành.
AUDIO_UPLOAD_TOKEN_SECRET=
AUDIO_UPLOAD_REQUIRE_SCOPED_TOKEN=false
AUDIO_UPLOAD_CREATE_REQUESTS_PER_MINUTE=30
AUDIO_UPLOAD_SESSION_REQUESTS_PER_MINUTE=180

# Secret dùng cho các endpoint cleanup nội bộ. Có thể gọi hằng ngày:
# /api/internal/audio-sessions/cleanup và /api/internal/data-retention/cleanup
CRON_SECRET=

# Bucket R2 riêng tư cho JSON app_records (dùng chung R2 credentials ở trên).
# Cron mỗi 5 phút xuất 50 dòng cũ nhất của TẤT CẢ namespace rồi xóa bản không đổi.
APP_RECORDS_ARCHIVE_R2_BUCKET=

# Chính sách cập nhật APK Android tải trực tiếp. Chỉ tăng
# ANDROID_MIN_SUPPORTED_BUILD sau khi APK mới đã upload và cài đè thành công.
ANDROID_LATEST_VERSION=1.0.0
ANDROID_LATEST_BUILD=2
ANDROID_MIN_SUPPORTED_BUILD=2
ANDROID_UPDATE_URL=https://yellow-darkness-4f0d.huameizhongxin.workers.dev/
ANDROID_UPDATE_MESSAGE_VI=Đã có phiên bản mới. Vui lòng cập nhật để tiếp tục sử dụng.
ANDROID_UPDATE_MESSAGE_ZH=已有新版本，请更新后继续使用。
