# Bắt buộc để đăng nhập trang quản trị ở cả local và production.
# Dùng mật khẩu dài, riêng biệt; thay đổi một trong hai giá trị sẽ đăng xuất mọi phiên cũ.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Xác thực installation ẩn danh dùng chung cho iOS, Android và Flutter Web.
# Tạo secret riêng tối thiểu 32 ký tự. Production luôn bắt buộc bearer token;
# REQUIRED=false chỉ giữ tương thích legacy khi phát triển local.
INSTALLATION_AUTH_SECRET=
INSTALLATION_AUTH_REQUIRED=false
# Hạn access token. Ngắn vì mặc định server không đọc database khi kiểm tra token:
# token bị thu hồi/refresh qua backend khác chỉ còn dùng được tối đa chừng ấy thời gian.
INSTALLATION_ACCESS_TTL_SECONDS=900
INSTALLATION_REFRESH_TTL_SECONDS=7776000
INSTALLATION_REGISTRATION_REQUESTS_PER_MINUTE=12
# token (mặc định) = chỉ kiểm tra chữ ký và hạn của access token, không query database.
# storage = đối chiếu mọi token với bản ghi installation (có cache bên dưới).
INSTALLATION_ACCESS_VERIFICATION=token
# Chỉ dùng khi VERIFICATION=storage: nhớ kết quả kiểm tra token trong bộ nhớ mỗi backend (ms) để không truy vấn database
# ở mọi request. Mặc định 30000, tối đa 60000, 0 = tắt. Token bị thu hồi qua backend
# khác vẫn dùng được tối đa chừng ấy thời gian trên backend này.
INSTALLATION_ACCESS_CACHE_TTL_MS=30000
# CHỈ dùng trên dev khi chạy test tải: installation có clientId bắt đầu bằng tiền tố này
# (k6 tạo "web_k6_<hex>") không ghi lịch sử hội thoại và không upload audio lên Cloudinary.
# Tối thiểu 6 ký tự. Để trống trên production.
LOAD_TEST_SKIP_PERSISTENCE_CLIENT_PREFIX=
# CHỈ dùng trên dev: true = các installation khớp tiền tố trên KHÔNG dùng cache nào (không đọc, không
# ghi, không dùng chung với lượt khác): tiếng Anh bỏ luật dịch sẵn + cache bản dịch + cache audio,
# audio stream tạo mới; Trung/Nhật/Hàn/Pháp nhận URL /api/audio/target ký kèm mã job riêng của lượt
# đó (vẫn trả bản dịch trước, stream hoặc MP3 như người dùng thật). Preview luôn "không khớp".
# Để đo tải thật của bước dịch và tạo giọng. Để trống trên production.
LOAD_TEST_BYPASS_AUDIO_CACHE=

# Bắt buộc để lưu giọng nói của người dùng sau khi backend đã trả phản hồi.
# Audio được upload dưới dạng Cloudinary video/authenticated và chỉ phát qua API admin.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_USER_AUDIO_FOLDER=speaking-ai/user-audio
# Production child-data retention. Cleanup runs on startup and then daily.
# Audio is removed from Cloudinary after 30 days while the transcript remains
# until the 180-day history limit. Detailed benchmark/latency data is removed
# after 30 days. Manual deletion/consent withdrawal deletes all three at once.
USER_AUDIO_RETENTION_DAYS=30
HISTORY_RETENTION_DAYS=180
DIAGNOSTIC_RETENTION_DAYS=30
DATA_RETENTION_CLEANUP_INTERVAL_SECONDS=86400
# Legacy migration fallback only; leave empty when all three values above exist.
CHILD_DATA_RETENTION_DAYS=
LATENCY_P95_ALERT_MS=2500
# TTS chỉ dùng Cloudflare. Audio đã tạo được lưu vào cache dùng chung.
CLOUDFLARE_TTS_MODEL=@cf/deepgram/aura
CLOUDFLARE_TTS_SPEAKER=luna
CLOUDFLARE_TTS_TIMEOUT_MS=20000
# Pool: retry an attempt timeout, network error or HTTP 5xx once on another
# account (may be billed twice upstream). false restores no-retry behaviour.
CLOUDFLARE_POOL_RETRY_TRANSIENT=true
# Pool per-attempt timeouts (leave time for one retry inside the 20s deadline).
CLOUDFLARE_ASR_ATTEMPT_TIMEOUT_MS=8000
# Text attempt timeout (pooled and legacy) stays CLOUDFLARE_TEXT_TIMEOUT_MS, default 6000.
# /api/audio/translate starts English TTS in the background and returns audioUrl
# (default on). Set false to return text only.
AUDIO_TRANSLATE_EAGER_TTS=true
# Behind infra/nginx: this instance's routing key (its port) appended as
# &node= to stream URLs so audio returns to the instance that started TTS.
# Leave empty on single-instance or platform-managed replicas.
AUDIO_STREAM_NODE=
# Chỉ tạo trước tối đa 100-300 câu phổ biến; mặc định 200. Các rule còn lại
# sinh audio đúng một lần khi gặp lần đầu rồi lưu lâu dài trên backend.
AUDIO_WARMUP_RULE_LIMIT=200
AUDIO_WARMUP_CONCURRENCY=2

# ASR, dịch text V1 và TTS đều chỉ dùng Cloudflare Workers AI.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_API_TOKEN=
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
CLOUDFLARE_TEXT_TIMEOUT_MS=6000

# Endpoint audio/translate độc lập (không phải pipeline Flutter chính).
CLOUDFLARE_WORKERS_AI_MODEL=@cf/openai/whisper-large-v3-turbo
CLOUDFLARE_AUDIO_MAX_BYTES=10485760
CLOUDFLARE_WORKERS_AI_TIMEOUT_MS=6000
# Separate batch-translation deadline (capped at 30000ms); does not change ASR.
CLOUDFLARE_AUDIO_TRANSLATION_TIMEOUT_MS=20000

# Nhà cung cấp cho từng bước của POST /api/audio/translate (và audio worker),
# theo thứ tự ưu tiên: cloudflare (mặc định), deepinfra, hoặc danh sách như
# deepinfra,cloudflare = thử DeepInfra trước, lỗi (429/5xx/timeout/thiếu key)
# thì chuyển sang Cloudflare. Hai bước chọn độc lập với nhau.
# Không ảnh hưởng pipeline Flutter chính, dịch text V1 và TTS.
# Xem docs/deepinfra-audio-provider.md.
AUDIO_ASR_PROVIDER=cloudflare
AUDIO_TEXT_PROVIDER=cloudflare
# Chỉ cần khi một trong hai biến trên là deepinfra. Không commit key thật.
DEEPINFRA_API_KEY=
DEEPINFRA_ASR_MODEL=openai/whisper-large-v3-turbo
# Ghim bản có ngày để kết quả dịch không đổi khi DeepInfra cập nhật alias.
DEEPINFRA_TEXT_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
DEEPINFRA_ASR_TIMEOUT_MS=8000
DEEPINFRA_TEXT_TIMEOUT_MS=6000
# Tuỳ chọn: none|minimal|low|medium|high, gửi kèm reasoning_effort nếu model hỗ trợ.
DEEPINFRA_TEXT_REASONING_EFFORT=
# Giữ kết nối tới DeepInfra khi rảnh (ms). DeepInfra giữ ít nhất 60s; Node mặc định chỉ 4s.
DEEPINFRA_KEEPALIVE_MS=50000
# Gửi song song (hedge): nếu nhà cung cấp đầu chưa trả lời sau N ms thì gọi thêm
# nhà cung cấp kế tiếp, bên nào xong trước thì dùng, bên kia bị huỷ. 0 = tắt.
# Gợi ý theo p90 đo được: ASR 2000, dịch 1600 (khoảng 10% request gọi thêm Cloudflare).
AUDIO_ASR_HEDGE_MS=0
AUDIO_TEXT_HEDGE_MS=0
# Giọng đọc bản dịch tiếng Trung/Nhật/Hàn/Pháp: cloudflare (mặc định, xai/grok-tts),
# deepinfra (Qwen3-TTS) hoặc google (Google Cloud Text-to-Speech, gRPC). Chỉ một nhà cung cấp,
# không có dự phòng. deepinfra cần DEEPINFRA_API_KEY; google cần tài khoản dịch vụ (bên dưới).
AUDIO_TARGET_TTS_PROVIDER=cloudflare
# --- google ---
# JSON khoá tài khoản dịch vụ (dán nguyên JSON hoặc base64), cần quyền gọi Cloud Text-to-Speech.
# Để trống thì dùng Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS hoặc gcloud).
GOOGLE_TTS_CREDENTIALS_JSON=
# Giọng (không kèm mã vùng; mã vùng tự thêm: cmn-CN, ja-JP, ko-KR, fr-FR). Chirp 3 HD: Aoede, Kore, Puck...
GOOGLE_TTS_VOICE=Chirp3-HD-Aoede
# Giọng cho câu ngắn (file MP3 hoàn chỉnh) theo từng ngôn ngữ; để trống thì dùng GOOGLE_TTS_VOICE.
# Câu dài (stream) luôn dùng GOOGLE_TTS_VOICE: Google chỉ stream được giọng Chirp3-HD.
# Ví dụ giọng nữ Neural2 ($16 / 1 triệu ký tự, Chirp3-HD là $30): ja Neural2-B, ko Neural2-A, fr Neural2-F.
# Tiếng Trung không có Neural2.
GOOGLE_TTS_CLIP_VOICE_ZH=
GOOGLE_TTS_CLIP_VOICE_JA=
GOOGLE_TTS_CLIP_VOICE_KO=
GOOGLE_TTS_CLIP_VOICE_FR=
# Giọng đọc tiếng Anh (/api/audio/stream): cloudflare (mặc định, @cf/deepgram/aura-1) hoặc google.
# google: câu ngắn (dưới AUDIO_ENGLISH_STREAM_MIN_CHARS ký tự, khoảng 1-3 giây) là file MP3 giọng
# GOOGLE_TTS_CLIP_VOICE_EN (ví dụ Neural2-F); câu dài hơn stream giọng GOOGLE_TTS_VOICE (Chirp3-HD).
# Stream bị Google từ chối (429...) thì đọc bằng giọng câu ngắn; Google lỗi hẳn thì quay về Cloudflare.
# Cần tài khoản dịch vụ Google ở trên.
AUDIO_ENGLISH_TTS_PROVIDER=cloudflare
GOOGLE_TTS_CLIP_VOICE_EN=
# Đo 2026-11-18: en-US Neural2 đọc khoảng 16 ký tự/giây, nên 50 ký tự là khoảng 3 giây.
AUDIO_ENGLISH_STREAM_MIN_CHARS=50
# Chia một phần câu ngắn (file MP3) sang DeepInfra (Qwen3-TTS) để giảm tải cho Google. 0.33 = khoảng 1/3.
# Chọn theo câu (cùng một câu luôn đi cùng một nơi, nên cache vẫn đúng). DeepInfra bận hoặc lỗi thì
# Google đọc thay bằng giọng câu ngắn ở trên. Cần DEEPINFRA_API_KEY. 0 hoặc để trống = tắt.
AUDIO_TARGET_CLIP_DEEPINFRA_SHARE=0
# Hạn cho một clip hoàn chỉnh (SynthesizeSpeech) và cho cả luồng stream (StreamingSynthesize).
GOOGLE_TTS_TIMEOUT_MS=10000
GOOGLE_TTS_STREAM_TIMEOUT_MS=20000
# Số lần gọi Google cùng lúc tối đa trên MỖI backend. Google cho 100 phiên stream cùng lúc / project,
# dùng chung cho mọi backend dev + production. Vượt mức thì chờ tối đa GOOGLE_TTS_QUEUE_WAIT_MS.
GOOGLE_TTS_MAX_CONCURRENCY=16
GOOGLE_TTS_QUEUE_WAIT_MS=3000
DEEPINFRA_TTS_MODEL=Qwen/Qwen3-TTS
# Giọng có sẵn của Qwen3-TTS: Vivian, Serena, Uncle_Fu, Dylan, Eric, Ryan, Aiden, Ono_Anna, Sohee.
DEEPINFRA_TTS_VOICE=Sohee
DEEPINFRA_TTS_TIMEOUT_MS=10000
# true = trả bản dịch Trung/Nhật/Hàn/Pháp trước, kèm audioUrl ký sẵn tới /api/audio/target;
# audio được tạo ngay lúc đó và app tải sau. Chỉ có tác dụng khi AUDIO_TARGET_TTS_PROVIDER=deepinfra hoặc google.
# Ký bằng INSTALLATION_AUTH_SECRET (link hết hạn sau 15 phút). Câu dịch > 300 ký tự vẫn chờ audio như cũ.
AUDIO_TARGET_TTS_DEFERRED=false
# true = (cần AUDIO_TARGET_TTS_DEFERRED=true) tạo giọng qua POST /v1/text-to-speech/{voice}/stream
# của DeepInfra (hoặc StreamingSynthesize của Google khi provider=google): nhận PCM, gửi thẳng cho app dạng WAV không nén (audio/wav, nặng khoảng 8 lần MP3),
# /api/audio/target phát dần (không có Content-Length). Cache lưu .wav. Stream lỗi trước byte đầu
# thì dùng /audio/speech (WAV hoàn chỉnh). Không dùng được với AUDIO_STORAGE_BACKEND=cloudinary.
AUDIO_TARGET_TTS_STREAM=false
# Khi AUDIO_TARGET_TTS_STREAM=true: chỉ câu dịch dài mới stream WAV; câu ngắn hơn ngưỡng (số ký tự)
# trả file MP3 hoàn chỉnh (nhẹ hơn ~8 lần, player tự biết lúc hết). Bản dịch luôn trả trước.
# Trung/Nhật/Hàn: 20 ký tự ≈ 3,5 s giọng đọc. Pháp: 50 ký tự ≈ 3,5 s.
AUDIO_TARGET_STREAM_MIN_CHARS=20
AUDIO_TARGET_STREAM_MIN_CHARS_FR=50
# Ngưỡng riêng cho từng ngôn ngữ, ưu tiên hơn ngưỡng chung ở trên (để trống thì dùng ngưỡng chung).
AUDIO_TARGET_STREAM_MIN_CHARS_ZH=
AUDIO_TARGET_STREAM_MIN_CHARS_JA=
AUDIO_TARGET_STREAM_MIN_CHARS_KO=
# true = (chỉ dev) bật POST /api/audio/target/url: ký URL /api/audio/target cho một câu bất kỳ để test
# stream. Cần installation token. Mỗi URL gọi tới là một lần TTS trả phí; production để false.
AUDIO_TARGET_URL_ENDPOINT=false
# Hạn cho cả luồng stream (header + toàn bộ audio).
DEEPINFRA_TTS_STREAM_TIMEOUT_MS=20000
# Số lần gọi Qwen3-TTS cùng lúc tối đa trên MỖI backend. Vượt mức thì chờ slot trống thay vì để
# DeepInfra trả 429 (mất giọng). Hạn mức DeepInfra tính theo tài khoản, dùng chung cho mọi backend
# dev + production: tổng = số backend x giá trị này (4 backend dev x 40 = 160).
DEEPINFRA_TTS_MAX_CONCURRENCY=40
# Chờ slot tối đa bao lâu; quá hạn thì lượt đó không có giọng (reason queue_timeout, 429).
DEEPINFRA_TTS_QUEUE_WAIT_MS=3000

# Optional dedicated account pool for POST /api/audio/translate only.
# Leave disabled until dedicated account quotas, Redis and staging quality/load
# have been verified. See docs/cloudflare-multi-account-runbook.md for the JSON.
CLOUDFLARE_AUDIO_TRANSLATION_POOL_ENABLED=false
# Opt-in for local audio-only load tests with two total accounts.
# Rejected in production and with a remote Redis URL; legacy calls are untracked.
CLOUDFLARE_POOL_ALLOW_LEGACY_ACCOUNT_LOCAL_TEST=false
# Production sharing: legacy ASR/text/TTS take permits from the same Redis as
# audio/translate and remain pinned to CLOUDFLARE_ACCOUNT_ID. Requires that
# enabled account and every legacy model in the registry, including capabilities
# tts:[CLOUDFLARE_TTS_MODEL,"xai/grok-tts"] and a limits.tts quota. LOCAL_TEST=false.
CLOUDFLARE_POOL_SHARE_LEGACY_ACCOUNT=false
# Stage 2 only: enable after ALL backends/workers use shared legacy admission.
# false keeps audio/translate on dedicated accounts during the migration.
CLOUDFLARE_POOL_ROUTE_LEGACY_ACCOUNT=false
# Stage 3 only (requires ROUTE=true): legacy ASR/text/TTS are no longer pinned to
# CLOUDFLARE_ACCOUNT_ID and may run on any enabled account that lists the model in
# capabilities. Give the second account the same asr/text/tts models and a
# limits.tts quota to let it take the same work. false keeps legacy calls pinned.
CLOUDFLARE_POOL_BALANCE_LEGACY_CALLS=false
CLOUDFLARE_POOL_STORE=redis
CLOUDFLARE_POOL_REDIS_URL=
# Local Docker Redis password; shared only with the local Redis container.
# This is not a Cloudflare API token. See docs/redis-local.md.
CLOUDFLARE_POOL_REDIS_PASSWORD=
CLOUDFLARE_POOL_NAMESPACE=speaking-ai-cf-quota-v1
CLOUDFLARE_POOL_CONFIG_VERSION=
CLOUDFLARE_ACCOUNTS_JSON=[]
CLOUDFLARE_POOL_A_TOKEN=
CLOUDFLARE_POOL_B_TOKEN=
CLOUDFLARE_POOL_MAX_ATTEMPTS_PER_STAGE=2
CLOUDFLARE_POOL_MAX_ATTEMPTS_PER_REQUEST=3
# Opt in to bounded waiting across request admission, ASR and text. 0 = fail fast.
CLOUDFLARE_POOL_MAX_WAIT_MS=5000
# Per-process pending request limit; also caps concurrent stage waiters.
CLOUDFLARE_POOL_MAX_QUEUED=40
# Reserved raw multipart bytes across uploads, queued and active requests (32 MiB).
CLOUDFLARE_POOL_MAX_BUFFERED_BYTES=33554432
# Maximum pooled audio requests held by each backend process after validation.
CLOUDFLARE_POOL_MAX_IN_FLIGHT=20
CLOUDFLARE_POOL_MIN_ATTEMPT_MS=250

CLOUDFLARE_ASR_TIMEOUT_MS=4000
# 2 ưu tiên tốc độ cho câu ngắn; đặt 5 để quay lại beam mặc định của model.
CLOUDFLARE_ASR_BEAM_SIZE=2
# client: disable Cloudflare VAD only when Flutter confirms client-side VAD.
# cloudflare: keep provider VAD enabled for an A/B comparison or rollback.
CLOUDFLARE_ASR_VAD_MODE=client

# Reviewed child-speech aliases are enabled by default and use an in-memory
# exact full-sentence lookup. Set false only for an emergency pilot rollback.
CHILD_SPEECH_ALIASES_ENABLED=true

# Danh sách origin Flutter Web/PWA, phân cách bằng dấu phẩy. Không thêm dấu / cuối.
# Ví dụ: https://app.innotrik.com,https://staging-app.innotrik.com
PWA_ALLOWED_ORIGINS=

# Lưu trữ production. Giữ "local" trong lúc phát triển một máy.
PERSISTENCE_BACKEND=local
AUDIO_STORAGE_BACKEND=local
# TTS Cloudinary cache (separate from private user-audio credentials).
# Set AUDIO_STORAGE_BACKEND=cloudinary and keep DATABASE_URL for the URL index.
CLOUDINARY_TTS_CLOUD_NAME=
CLOUDINARY_TTS_API_KEY=
CLOUDINARY_TTS_API_SECRET=

# Khi chuyển production: PERSISTENCE_BACKEND=postgres và cấu hình Neon.
# Nếu bỏ trống AUDIO_STORAGE_BACKEND, audio cũng tự dùng PostgreSQL để không
# mất cache sau deploy/restart. Có thể đặt rõ AUDIO_STORAGE_BACKEND=postgres.
DATABASE_URL=

# Khi chuyển audio production: AUDIO_STORAGE_BACKEND=vercel-blob.
# Store này phải là public vì chỉ chứa câu tiếng Anh đã sinh, không chứa giọng trẻ.
GENERATED_AUDIO_BLOB_READ_WRITE_TOKEN=

# Hoặc dùng Cloudflare R2 cho audio cache bất biến. Chỉ bật sau khi đã tạo
# R2 API token và public/custom domain cho bucket.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Production fast path: keep temporary chunk bytes in private R2 objects while
# PostgreSQL stores only session metadata. AUDIO_STORAGE_BACKEND=r2 enables this
# automatically; this explicit setting also works when generated audio uses a
# different backend. Add an R2 lifecycle rule for audio-sessions/ (1 day).
AUDIO_SESSION_CHUNK_STORAGE_BACKEND=

# Giới hạn upload giọng nói của trẻ. Metadata session và chunk tự xóa sau TTL;
# bytes của chunk nằm trong R2 khi bật fast path ở trên.
AUDIO_UPLOAD_MAX_CHUNK_BYTES=1048576
AUDIO_UPLOAD_MAX_SESSION_BYTES=16777216
AUDIO_UPLOAD_MAX_CHUNKS=1000
AUDIO_UPLOAD_SESSION_TTL_SECONDS=900
# Bounded per-instance PCM shadow cache; set 0 to force PostgreSQL/R2 assembly.
AUDIO_SESSION_HOT_CACHE_MAX_BYTES=67108864
AUDIO_FINALIZED_RESULT_TTL_SECONDS=86400
AUDIO_FINALIZE_LEASE_SECONDS=60
AUDIO_UPLOAD_CLEANUP_INTERVAL_SECONDS=300

# Khóa HMAC riêng để cấp upload token ngắn hạn, ràng buộc từng audio session.
# Production luôn bắt buộc scoped token. Nếu để trống, khóa ký upload được
# suy ra độc lập từ INSTALLATION_AUTH_SECRET; có thể cấp khóa riêng >=32 ký tự.
AUDIO_UPLOAD_TOKEN_SECRET=
AUDIO_UPLOAD_REQUIRE_SCOPED_TOKEN=false
AUDIO_UPLOAD_CREATE_REQUESTS_PER_MINUTE=30
AUDIO_UPLOAD_SESSION_REQUESTS_PER_MINUTE=180

# Secret dùng cho các endpoint cleanup nội bộ. Có thể gọi hằng ngày:
# /api/internal/audio-sessions/cleanup và /api/internal/data-retention/cleanup
CRON_SECRET=

# Bucket R2 riêng tư cho JSON app_records (dùng chung R2 credentials ở trên).
# Chỉ xuất 1-50 conversation_preparations_v1 đã hết hạn rồi xóa bản không đổi.
# Không archive/xóa auth, profile, history, rule hoặc commit-idempotency marker.
APP_RECORDS_ARCHIVE_R2_BUCKET=

# Chính sách cập nhật APK Android tải trực tiếp. Chỉ tăng
# ANDROID_MIN_SUPPORTED_BUILD sau khi APK mới đã upload và cài đè thành công.
ANDROID_LATEST_VERSION=1.0.0
ANDROID_LATEST_BUILD=2
ANDROID_MIN_SUPPORTED_BUILD=2
ANDROID_UPDATE_URL=https://yellow-darkness-4f0d.huameizhongxin.workers.dev/
ANDROID_UPDATE_MESSAGE_VI=Đã có phiên bản mới. Vui lòng cập nhật để tiếp tục sử dụng.
ANDROID_UPDATE_MESSAGE_ZH=已有新版本，请更新后继续使用。

# Audio translation optimizations; opt in after measuring the uncached baseline.
# Use separate Redis INSTANCES for cache, jobs and provider quota (not just DB numbers).
AUDIO_TRANSLATION_CACHE_ENABLED=false
AUDIO_TRANSLATION_CACHE_REDIS_URL=
AUDIO_TRANSLATION_CACHE_TTL_SECONDS=300
# One translation per sentence, shared by every client: the text model is skipped
# when any user has already said the same sentence. Stores only the transcript and
# its English translation in the cache Redis (AUDIO_TRANSLATION_CACHE_REDIS_URL).
# Independent of AUDIO_TRANSLATION_CACHE_ENABLED and its per-client in-flight limits.
AUDIO_TRANSLATION_SHARED_TEXT_CACHE_ENABLED=false
# Default 1 day; allowed 60 seconds to 30 days. A wrong translation is served to
# every client until it expires, so prefer a short lifetime.
AUDIO_TRANSLATION_SHARED_TEXT_CACHE_TTL_SECONDS=86400
AUDIO_TRANSLATION_MAX_IN_FLIGHT_PER_CLIENT=4
# Conservative PCM16 WAV edge trimming. Keep off until speech quality is reviewed.
AUDIO_TRANSLATION_TRIM_WAV=false
# Zero disables the local backlog gate. Shared provider quota always remains enforced.
CLOUDFLARE_POOL_TEXT_BACKLOG_THRESHOLD=0

# POST /api/audio/jobs, or Prefer: respond-async fallback on /api/audio/translate.
# Jobs require installation bearer auth, even when legacy synchronous access is allowed.
AUDIO_TRANSLATION_JOBS_ENABLED=false
AUDIO_TRANSLATION_JOBS_REDIS_URL=
AUDIO_TRANSLATION_JOB_NAMESPACE=speaking-ai-audio-jobs
AUDIO_TRANSLATION_JOB_MAX_PENDING=100
AUDIO_TRANSLATION_JOB_MAX_PER_CLIENT=10
AUDIO_TRANSLATION_JOB_WORKER_CONCURRENCY=4
# Optional: pin this worker process to one pool account alias (for example audio-a).
# Unset: the worker shares every enabled account and can retry on another one.
AUDIO_TRANSLATION_JOB_WORKER_ACCOUNT=
# local is for development; production needs R2 or an explicitly mounted shared directory.
AUDIO_TRANSLATION_JOB_STORAGE=local
AUDIO_TRANSLATION_JOB_SHARED_DIRECTORY=

# Nginx + Docker: npm run lb:up (requires Docker Compose >= 2.20).
# Only Nginx is published; backend containers share PostgreSQL and Redis.
# Runtime secrets are mounted from .env.local and are never copied into the image.
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_HTTP_PORT=8080
# The two named backend services listen internally on ports 3000 and 3001.
BACKEND_IMAGE_TAG=local

# Interactive API docs at /docs (Swagger UI), /redoc and /openapi.json. Set to false to hide them.
API_DOCS_ENABLED=true
