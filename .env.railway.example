# Copy settings into Railway Variables; never commit filled credentials.
# Web: railway.json / Dockerfile. Optional worker: railway.worker.json / Dockerfile.worker.
APP_RUNTIME=railway
NODE_ENV=production
# PORT is supplied by Railway. The startup script binds 0.0.0.0.

# Required: this version uses Neon's HTTP driver, so retain a Neon database.
DATABASE_URL=
PERSISTENCE_BACKEND=postgres
AUDIO_STORAGE_BACKEND=postgres
AUDIO_SESSION_CHUNK_STORAGE_BACKEND=postgres
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Generate a random stable secret of at least 32 characters; share with worker/replicas.
INSTALLATION_AUTH_SECRET=
INSTALLATION_AUTH_REQUIRED=true
# Optional dedicated upload key >=32 chars; otherwise a separate key is derived above.
AUDIO_UPLOAD_TOKEN_SECRET=
AUDIO_UPLOAD_REQUIRE_SCOPED_TOKEN=true

# Required for the web conversation/ASR/text/TTS pipeline.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_API_TOKEN=
CLOUDFLARE_WORKERS_AI_MODEL=@cf/openai/whisper-large-v3-turbo
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
CLOUDFLARE_TTS_MODEL=@cf/deepgram/aura-1
CLOUDFLARE_TTS_SPEAKER=luna
# Required for authenticated private user recordings, independent of generated TTS.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
USER_AUDIO_RETENTION_DAYS=30
HISTORY_RETENTION_DAYS=180
DIAGNOSTIC_RETENTION_DAYS=30
DATA_RETENTION_CLEANUP_INTERVAL_SECONDS=86400
PWA_ALLOWED_ORIGINS=

# Optional features: enable only with their dependencies provisioned.
CLOUDFLARE_AUDIO_TRANSLATION_POOL_ENABLED=false
CLOUDFLARE_POOL_STORE=redis
CLOUDFLARE_POOL_REDIS_URL=
CLOUDFLARE_ACCOUNTS_JSON=[]
CLOUDFLARE_POOL_ALLOW_LEGACY_ACCOUNT_LOCAL_TEST=false
CLOUDFLARE_POOL_SHARE_LEGACY_ACCOUNT=false
CLOUDFLARE_POOL_ROUTE_LEGACY_ACCOUNT=false
# Add the token env names referenced by your registry; no Compose Redis password needed.
AUDIO_TRANSLATION_CACHE_ENABLED=false
AUDIO_TRANSLATION_CACHE_REDIS_URL=
AUDIO_TRANSLATION_JOBS_ENABLED=false
AUDIO_TRANSLATION_JOBS_REDIS_URL=
AUDIO_TRANSLATION_JOB_NAMESPACE=speaking-ai-audio-jobs
# Required for jobs on Railway: web and worker use the same private R2 bucket.
AUDIO_TRANSLATION_JOB_STORAGE=r2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
# Only required if AUDIO_STORAGE_BACKEND=r2 (public generated TTS bucket).
CLOUDFLARE_R2_PUBLIC_BASE_URL=
# Optional cron: expired preparation archive only. Leave off until bucket is configured.
APP_RECORDS_ARCHIVE_R2_BUCKET=
CRON_SECRET=
